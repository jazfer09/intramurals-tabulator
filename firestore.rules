rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getRole() == 'admin';
    }

    function isScorerOrAdmin() {
      return isSignedIn() && (getRole() == 'scorer' || getRole() == 'admin');
    }

    // Users collection: holds each account's role + assigned events.
    // Users can read their own doc (to know their role) and admins can read/write all.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId; // signup writes own doc, defaults to viewer
      allow update: if isAdmin(); // only admin can change roles / assignments
      allow delete: if isAdmin();
    }

    // Events (e.g. "100m Dash", "Basketball Finals")
    match /events/{eventId} {
      allow read: if true; // public scoreboard needs to read event names
      allow write: if isAdmin();
    }

    // Teams / houses / sections joining the intramurals
    match /teams/{teamId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Scores: publicly readable (for the live scoreboard),
    // only scorers/admins can add, only admins can edit/delete (corrections).
    match /scores/{scoreId} {
      allow read: if true;
      allow create: if isScorerOrAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
